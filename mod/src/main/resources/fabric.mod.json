  "authors": ["Omo Research"],
  "contributors": ["CC: Tweaked by Daniel Ratcliffe, SquidDev and contributors", "MCEF Modern by DimasKama"],
  "contact": {
    "homepage": "https://omo.space"
  },
  "license": "MIT",
  "icon": "assets/omolife/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["space.omo.life.OmoLife"],
    "client": ["space.omo.life.client.OmoLifeClient"]
  },
  "mixins": ["omolife.mixins.json", "omolife.mcef.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "~26.2",
    "computercraft": ">=1.120.0"
